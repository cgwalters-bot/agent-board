  },
  "wip": 8,
  "triage": {
    "scope": "epics"
  },
  "planPools": [
    "claude",
    "openai"
  ],
  "pools": {
    "claude": {},
    "openai": {}
  },
  "midstream": {
    "owner": "cgwalters-forge",
    "topic": "bot-midstream"
  },
  "usage": {
    "repository": "cgwalters-forge/bot-ops",
    "issue": 1,
    "probe": true
  },
  "pr": {
    "fixPools": [
      "claude",
      "openai"
    ]
  }
}
