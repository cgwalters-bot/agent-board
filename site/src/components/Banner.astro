---
// Starlight's Banner, replaced: the page's LLM notice (llmNotice in
// ../../links.mjs), on every page whose source has it, the landing page
// included. The context sentences are text, not HTML as in Starlight's
// banner, so a document's words cannot add markup to the site.
import { LLM_NOTICE } from "../../links.mjs";

const { llmNotice } = Astro.locals.starlightRoute.entry.data;
---

{
  llmNotice !== undefined && (
    <div class="sl-banner" data-llm-notice data-pagefind-ignore>
      {LLM_NOTICE}{llmNotice && ` ${llmNotice}`}
    </div>
  )
}

<style>
  /* Starlight's banner colours, which it sets for both themes. */
  .sl-banner {
    --__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
    color: var(--__sl-banner-text);
    line-height: var(--sl-line-height-headings);
    text-align: center;
    text-wrap: balance;
    box-shadow: var(--sl-shadow-sm);
  }
  .sl-banner a {
    color: var(--__sl-banner-text);
    text-decoration: underline;
  }
</style>
